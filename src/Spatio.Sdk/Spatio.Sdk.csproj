<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo><!-- setting GenerateAssemblyInfo to false causes this bug https://github.com/dotnet/project-system/issues/3934 -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Spatio.Sdk</AssemblyName>
    <PackageId>Spatio.Sdk</PackageId>
    <OutputType>Library</OutputType>
    <Authors>OpenAPI</Authors>
    <Company>OpenAPI</Company>
    <AssemblyTitle>OpenAPI Library</AssemblyTitle>
    <Description>A library generated from a OpenAPI doc</Description>
    <Copyright>No Copyright</Copyright>
    <RootNamespace>Spatio.Sdk</RootNamespace>
    <Version>0.0.1</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Spatio.Sdk.xml</DocumentationFile>
    <RepositoryUrl>https://github.com/spatio-labs/spatio-csharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Minor update</PackageReleaseNotes>
    <Nullable>annotations</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <PackageId>Spatio.Sdk</PackageId>
    <Authors>Spatio Labs</Authors>
    <Description>C# SDK for the SpatioAPI. Generated from the official OpenAPI spec.</Description>
    <PackageProjectUrl>https://www.spatio.app/developers/docs/sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/spatio-labs/spatio-csharp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>spatio;sdk;api;openapi</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSubTypes" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Polly" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
